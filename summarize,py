import streamlit as st
from ocr_module import extract_text_from_image, extract_text_from_pdf
from summarize_module import summarize_text

st.title("🧠 Summarize Text from Image or PDF")

uploaded_file = st.file_uploader("Upload a file", type=["pdf", "jpg", "jpeg", "png"])

if uploaded_file:
    if uploaded_file.type == "application/pdf":
        text = extract_text_from_pdf(uploaded_file)
    else:
        text = extract_text_from_image(uploaded_file)

    if text.strip():
        st.subheader("Extracted Text")
        st.text_area("Text", text, height=200)

        st.subheader("Summary")
        summary = summarize_text(text)
        st.text_area("Summary", summary, height=150)
    else:
        st.warning("⚠️ No text could be extracted from the uploaded file.")

st.divider()
st.subheader("Navigate")

col1, col2 = st.columns(2)

with col1:
    st.page_link("pages/1_Home.py", label="🏠 Home", icon="🏡")

with col2:
    st.page_link("pages/3_About.py", label="ℹ️ About", icon="📘")
